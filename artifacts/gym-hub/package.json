{
  "name": "@workspace/gym-hub",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "NG_CLI_ANALYTICS=false ng serve --host 0.0.0.0 --port $PORT --configuration development",
    "build": "NG_CLI_ANALYTICS=false ng build --configuration production --output-path dist/public",
    "serve": "npx http-server dist/public -p $PORT",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@ionic/angular": "^7.8.4",
    "ionicons": "^7.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "typescript": "~5.4.2"
  }
}
